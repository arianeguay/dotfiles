#!/usr/bin/env bash
# Runs a command on athena from the current repository instead of on this machine.
# Usage: athena-run [--fetch <path>]... <command...>
set -euo pipefail

usage() { echo "usage: athena-run [--fetch <path>]... <command...>" >&2; exit 2; }
fetch=()
while [ $# -gt 0 ]; do
  case $1 in
    --fetch) [ $# -ge 2 ] || usage; fetch+=("$2"); shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage

root=$(git rev-parse --show-toplevel)
repo=$(basename "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')")
branch=$(git -C "$root" branch --show-current | tr '/' '-')
dir=athena-run/$repo/${branch:-detached}
rel=$(git rev-parse --show-prefix)

ssh -n -o ConnectTimeout=5 athena "mkdir -p $dir" ||
  { echo "athena-run: athena does not answer (powered off? AthenaAllumer turns it on)" >&2; exit 1; }

# git's file list, with each parent directory, so a fixture tracked under an ignored path is sent.
# On athena, a file git ignores (node_modules, .venv, build output) is kept; anything else
# not in the list is deleted, so a file removed from the branch is gone there too.
rules=$(mktemp); trap 'rm -f "$rules"' EXIT
git -C "$root" ls-files -co --exclude-standard |
  awk '{n=split($0,p,"/"); d=""; for(i=1;i<n;i++){d=d"/"p[i]; print "+ " d "/"} print "+ /" $0}' |
  sort -u > "$rules"
rsync -az --delete-excluded --filter=". $rules" --filter=":-r .gitignore" --filter="- *" \
  "$root/" "athena:$dir/"

status=0
# ssh joins its arguments into one string for the remote shell, so each one is quoted first.
ssh athena "bash -s -- $(printf '%q ' "$dir" "$rel" "$*")" <<'EOF' || status=$?
set -uo pipefail
dir=$HOME/$1 rel=$2 cmd=$3
# One job at a time, at the lowest CPU and disk priority: llama-swap answers the voice
# assistant and email drafting on this host and must not wait behind a job.
exec 9>"$HOME/athena-run/lock"
flock -n 9 || { echo "athena-run: waiting for another session's job on athena" >&2; flock 9; }
cd "$dir/$rel"
# Joined like ssh joins its arguments: `athena-run 'bun install && bun test'` runs both.
exec nice -n 19 ionice -c3 bash -lc "$cmd"
EOF

for p in "${fetch[@]}"; do
  p=${p%/}
  mkdir -p "$root/$rel$(dirname "$p")"
  rsync -az "athena:$dir/$rel$p" "$root/$rel$(dirname "$p")/" || status=$?
done
exit "$status"
