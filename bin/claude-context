#!/usr/bin/env python3
"""Context and token usage of every Claude Code session on this machine, by day and week.

Usage: claude-context [--weeks N] [--reset ISO_DATETIME (default Sundays 18:00)] [--sessions] [--csv PATH] [--json PATH] [--studio-json PATH]
"""
import argparse
import base64
import csv
import glob
import json
import math
import os
import re
import socket
import statistics
import struct
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo

TZ = ZoneInfo("America/Toronto")
ROOT = os.path.expanduser("~/.claude/projects")
HOST = socket.gethostname()
KINDS = ("conversation", "studio", "subagent", "summarizer", "warmup")
TOKENS = ("fresh", "cache_write", "cache_write_5m", "cache_write_1h", "cache_read", "output")
# Unattended runs share a cwd (the home directory), so only their fixed first words tell them apart.
AUTOMATIONS = (
    ("Unattended nightly closing pass", "auto:ok closing"),
    ("Unattended nightly run", "auto:ok"),
    ("You validate pull request", "auto:ok merge"),
    ("Unattended run of ops scripts/fleet-invariants", "fleet checks"),
    ("Failure report on stdin", "digest"),
    ("You diagnose an outage", "outage diag"),
)
LONG_CONTEXT = 200_000


def project_of(cwd):
    return re.sub(r"/\.(claude/)?worktrees/.*$", "", cwd) if cwd else ""


def work_of(cwd):
    """The ticket a cwd belongs to, else its worktree: what tells a bake-off apart from steady use."""
    ticket = re.search(r"\b(stu|hom|fx)-?(\d+)", cwd or "", re.I)
    if ticket:
        return f"{ticket[1].upper()}-{ticket[2]}"
    worktree = re.search(r"/\.(?:claude/)?worktrees/(.+)$", cwd or "")
    return worktree[1] if worktree else ""


def short_name(path):
    if not path:
        return "(unknown)"
    # Sessions started by a program from a temp dir (e.g. an app driving the CLI), not by hand.
    if re.match(r"/(private/)?var/folders/.*/T/[^/]+$", path):
        return f"{os.path.basename(path)} (temp)"
    return os.path.basename(path) or path


def first_text(d):
    c = d["message"]["content"]
    return c if isinstance(c, str) else " ".join(x.get("text", "") for x in c if isinstance(x, dict))


def classify(d):
    text = first_text(d)
    if text == "Warmup":
        return "warmup"
    if text.startswith("Context: This summary will be shown"):
        return "summarizer"
    if d.get("isSidechain"):
        return "subagent"
    # Studio's Claude provider spawns the CLI with skip-permissions; nothing else here does (measured on every host,
    # 2026-11-06). Its entrypoint is inherited, and its cwd can exist only inside a container, like skynet-counter's /app.
    if d.get("permissionMode") == "bypassPermissions":
        return "studio"
    return "conversation"


def automation_of(d):
    text = first_text(d)
    return next((name for prefix, name in AUTOMATIONS if text.startswith(prefix)), "")


def image_size(b64):
    raw = base64.b64decode(b64[:88000] + "=" * (-len(b64[:88000]) % 4))
    if raw[:8] == b"\x89PNG\r\n\x1a\n":
        return struct.unpack(">II", raw[16:24])
    i = 2
    while raw[:2] == b"\xff\xd8" and i + 9 < len(raw):
        if raw[i] != 0xFF:
            i += 1
        elif raw[i + 1] in (0xC0, 0xC1, 0xC2):
            h, w = struct.unpack(">HH", raw[i + 5:i + 9])
            return w, h
        else:
            i += 2 + struct.unpack(">H", raw[i + 2:i + 4])[0]
    return None


def image_tokens(content):
    """Estimated tokens of each image in a message, tool results included: long edge 1568 px, then w*h/750."""
    found = []
    for block in content if isinstance(content, list) else []:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "tool_result":
            found += image_tokens(block.get("content"))
        elif block.get("type") == "image":
            size = image_size((block.get("source") or {}).get("data") or "")
            if size:
                scale = min(1, 1568 / max(size))
                found.append(int(size[0] * size[1] * scale * scale / 750))
    return found


def bucket_of(ts):
    local = ts.astimezone(TZ)
    return local.replace(minute=local.minute - local.minute % 5, second=0, microsecond=0)


def load(path, since):
    t = {"kind": None, "session_id": None, "host": HOST, "automation": ""}
    custom, ai, cwd = None, None, None
    records = []
    # An image stays in the context, and is read back on each call, until a compaction drops it.
    pending, carried, image_cost = [], 0, {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            kind = d.get("type")
            if kind == "custom-title":
                custom = d.get("customTitle")
            elif kind == "ai-title":
                ai = d.get("aiTitle")
            elif kind == "user" and t["kind"] is None:
                t["kind"], t["session_id"], t["automation"] = classify(d), d.get("sessionId"), automation_of(d)
            cwd = cwd or d.get("cwd")
            msg = d.get("message")
            if kind == "system" and d.get("subtype") == "compact_boundary":
                pending, carried = [], 0
            elif kind == "user" and isinstance(msg, dict):
                pending += image_tokens(msg.get("content"))
            u = msg.get("usage") if isinstance(msg, dict) else None
            if not u or not d.get("timestamp"):
                continue
            key = (msg.get("id"), d.get("requestId")) if msg.get("id") or d.get("requestId") else (None, d.get("uuid"))
            if key not in image_cost:
                image_cost[key] = (len(pending), sum(pending), carried)
                carried += sum(pending)
                pending = []
            ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))
            if ts < since:
                continue
            split = u.get("cache_creation") or {}
            image_count, image_new, image_read = image_cost[key]
            records.append((key, {
                "image_count": image_count,
                "image_new": image_new,
                "image_read": image_read,
                "ts": ts,
                "bucket": bucket_of(ts),
                "model": msg.get("model") or "",
                "fresh": u.get("input_tokens", 0),
                "cache_write": u.get("cache_creation_input_tokens", 0),
                "cache_write_5m": split.get("ephemeral_5m_input_tokens", 0),
                "cache_write_1h": split.get("ephemeral_1h_input_tokens", 0),
                "cache_read": u.get("cache_read_input_tokens", 0),
                "output": u.get("output_tokens", 0),
                "t": t,
            }))
    t["kind"] = t["kind"] or "conversation"
    t["title"] = custom or ai or ""
    t["cwd"] = project_of(cwd)
    t["work"] = work_of(cwd)
    t["repo"] = short_name(t["cwd"])
    return t, records


def ctx(c):
    return c["fresh"] + c["cache_write"] + c["cache_read"]


def fingerprint(c):
    return (c["model"],) + tuple(c[k] for k in TOKENS)


def load_all(since):
    paths = sorted(
        (p for p in glob.glob(f"{ROOT}/**/*.jsonl", recursive=True)
         if datetime.fromtimestamp(os.path.getmtime(p), timezone.utc) >= since),
        key=os.path.getmtime,
    )
    # Last record wins: streaming records can carry placeholder counts, and a resumed
    # session can repeat earlier messages in a newer transcript.
    calls, first, read = {}, {}, 0
    for path in paths:
        _, records = load(path, since)
        for key, c in records:
            read += 1
            first.setdefault(key, c)
            calls[key] = c
    changed = sum(fingerprint(first[k]) != fingerprint(c) for k, c in calls.items())
    stats = {"read": read, "dropped": read - len(calls), "changed": changed}

    by_t = defaultdict(list)
    for c in calls.values():
        by_t[id(c["t"])].append(c)
    transcripts = []
    for cs in by_t.values():
        cs.sort(key=lambda c: c["ts"])
        t = cs[0]["t"]
        t["calls"] = cs
        t["start"] = cs[0]["bucket"]
        t["start_ctx"] = ctx(cs[0])
        t["peak_ctx"] = max(ctx(c) for c in cs)
        for k in TOKENS:
            t[k] = sum(c[k] for c in cs)
        t["input"] = ctx(t)
        transcripts.append(t)
    titles = {t["session_id"]: t["title"] for t in transcripts if t["kind"] == "conversation" and t["title"]}
    automations = {t["session_id"]: t["automation"] for t in transcripts if t["automation"]}
    for t in transcripts:
        t["title"] = t["title"] or titles.get(t["session_id"], "")
        t["automation"] = t["automation"] or automations.get(t["session_id"], "")
    return list(calls.values()), transcripts, stats


def week_key(reset):
    def key(c):
        n = math.floor((c["bucket"] - reset) / timedelta(days=7))
        return f"{reset + timedelta(days=7 * (n + 1)):%Y-%m-%d}"
    return key


def fmt(n):
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k"


def token_cols(cs):
    total = {k: sum(c[k] for c in cs) for k in TOKENS}
    cols = (total["fresh"], total["cache_write"] - total["cache_write_1h"], total["cache_write_1h"], total["cache_read"], total["output"])
    return "".join(f"{fmt(n):>9}" for n in cols)


TOKEN_HEADER = f"{'fresh':>9}{'w5m':>9}{'w1h':>9}{'read':>9}{'output':>9}"


def weight(c):
    """Public prices relative to fresh input. The limit's formula is not public, so this only compares periods."""
    w1h = c["cache_write_1h"]
    return c["fresh"] + 0.1 * c["cache_read"] + 1.25 * (c["cache_write"] - w1h) + 2 * w1h + 5 * c["output"]


def counts(cs):
    n = defaultdict(set)
    for c in cs:
        n[c["t"]["kind"]].add(id(c["t"]))
    return {kind: len(n[kind]) for kind in KINDS}


def report(title, calls, key):
    buckets = defaultdict(list)
    for c in calls:
        buckets[key(c)].append(c)
    convs = [c["t"] for c in calls if c["t"]["kind"] == "conversation" and c is c["t"]["calls"][0]]
    print(f"\n## {title}\n")
    print(f"{'period':<12}{'convs':>6}{'studio':>7}{'subagents':>10}{'background':>11}{'start ctx':>11}{'peak ctx':>10}" + TOKEN_HEADER)
    for k in sorted(buckets):
        b = buckets[k]
        n = counts(b)
        starts = [t["start_ctx"] for t in convs if key(t["calls"][0]) == k]
        print(
            f"{k:<12}{n['conversation']:>6}{n['studio']:>7}{n['subagent']:>10}{n['summarizer'] + n['warmup']:>11}"
            f"{fmt(statistics.median(starts)) if starts else '-':>11}{fmt(max(ctx(c) for c in b)):>10}" + token_cols(b)
        )


def report_pace(calls, reset, since):
    """A week still running only compares with past weeks cut at the same elapsed time."""
    now = datetime.now(TZ)
    start = reset + timedelta(days=7 * math.floor((now - reset) / timedelta(days=7)))
    elapsed = now - start
    print(f"\n## Pace: each week's first {elapsed.days}d {elapsed.seconds // 3600}h\n")
    print(f"{'week ending':<12}{'calls':>7}" + TOKEN_HEADER + f"{'weight':>9}")
    while start >= since:
        cs = [c for c in calls if start <= c["bucket"] < start + elapsed]
        print(f"{start + timedelta(days=7):%Y-%m-%d}  {len(cs):>7}" + token_cols(cs) + f"{fmt(sum(map(weight, cs))):>9}")
        start -= timedelta(days=7)
    print("weight = fresh + read x 0.1 + w5m x 1.25 + w1h x 2 + output x 5: public prices, the limit's formula is not public")


def report_models(calls, week):
    buckets = defaultdict(list)
    for c in calls:
        buckets[(week(c), c["model"])].append(c)
    print("\n## By model and week\n")
    print(f"{'week ending':<12}{'model':<28}{'calls':>7}" + TOKEN_HEADER + f"{'weight':>9}")
    for (w, model), cs in sorted(buckets.items(), key=lambda kv: (kv[0][0], -sum(map(weight, kv[1])))):
        print(f"{w:<12}{model[:27]:<28}{len(cs):>7}" + token_cols(cs) + f"{fmt(sum(map(weight, cs))):>9}")


def report_images(calls, week):
    total = sum(c["image_count"] for c in calls)
    if not total:
        return
    print("\n## Images (estimated tokens: width x height / 750)\n")
    print(f"{'':<36}{'images':>7}{'sent':>9}{'read back':>11}{'of writes':>11}{'of reads':>10}")
    weeks, repos = defaultdict(list), defaultdict(list)
    for c in calls:
        weeks[week(c)].append(c)
        repos[c["t"]["repo"]].append(c)
    top = sorted(repos.items(), key=lambda kv: -sum(c["image_read"] for c in kv[1]))[:5]
    for label, cs in sorted(weeks.items()) + top:
        new, back = sum(c["image_new"] for c in cs), sum(c["image_read"] for c in cs)
        if not new and not back:
            continue
        print(
            f"{label[:35]:<36}{sum(c['image_count'] for c in cs):>7}{fmt(new):>9}{fmt(back):>11}"
            f"{new / (sum(c['cache_write'] for c in cs) or 1) * 100:>10.1f}%{back / (sum(c['cache_read'] for c in cs) or 1) * 100:>9.1f}%"
        )


def studio_run_dirs():
    # A checkout's runs directory can be a link to a worktree's, so one directory has two paths.
    seen = set()
    home = os.path.expanduser("~")
    for path, dirs, _ in os.walk(home):
        runs = os.path.join(path, "runs")
        if path.endswith("/.studio") and "runs" in dirs and os.path.realpath(runs) not in seen:
            seen.add(os.path.realpath(runs))
            yield runs
        if path[len(home):].count("/") >= 10:
            dirs[:] = []
        dirs[:] = [x for x in dirs if x != "node_modules" and (not x.startswith(".") or x in (".studio", ".worktrees"))]


def load_studio_records(since, week):
    rows = defaultdict(lambda: defaultdict(int))
    for runs in studio_run_dirs():
        repo = short_name(project_of(runs[:-len("/.studio/runs")]))
        for path in glob.glob(f"{runs}/*.jsonl"):
            if datetime.fromtimestamp(os.path.getmtime(path), timezone.utc) < since:
                continue
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    try:
                        e = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if not isinstance(e, dict) or e.get("event") != "stage_complete" or not e.get("ts"):
                        continue
                    ts = datetime.fromisoformat(e["ts"].replace("Z", "+00:00"))
                    if ts < since:
                        continue
                    for model, n in ((e.get("tokens") or {}).get("by_model") or {}).items():
                        row = rows[(week({"bucket": bucket_of(ts)}), repo, model)]
                        row["stages"] += 1
                        for k in ("prompt_tokens", "cache_creation_tokens", "cached_input_tokens", "completion_tokens"):
                            row[k] += n.get(k) or 0
    return rows


def report_studio(calls, rows, week):
    """Studio's transcripts by week beside its own count per stage: the two need not match."""
    sessions = defaultdict(list)
    for c in calls:
        if c["t"]["kind"] == "studio":
            sessions[week(c)].append(c)
    records = defaultdict(lambda: defaultdict(int))
    for (w, _, model), r in rows.items():
        if model.startswith("claude-"):
            for k, v in r.items():
                records[w][k] += v
    if not sessions and not records:
        return
    print("\n## Studio by week: transcripts, then Studio's own records of Claude models\n")
    print(f"{'week ending':<12}{'calls':>7}" + TOKEN_HEADER + f"{'weight':>9}  |{'entries':>8}{'prompt':>9}{'write':>9}{'read':>9}{'output':>9}")
    for w in sorted(set(sessions) | set(records)):
        cs, r = sessions[w], records[w]
        print(
            f"{w:<12}{len(cs):>7}" + token_cols(cs) + f"{fmt(sum(map(weight, cs))):>9}  |{r['stages']:>8}{fmt(r['prompt_tokens']):>9}"
            f"{fmt(r['cache_creation_tokens']):>9}{fmt(r['cached_input_tokens']):>9}{fmt(r['completion_tokens']):>9}"
        )
    print("\n## Studio's own records, by stage\n")
    print(f"{'week ending':<12}{'repo':<24}{'model':<28}{'stages':>7}{'prompt':>9}{'write':>9}{'read':>9}{'output':>9}")
    for (w, repo, model), r in sorted(rows.items(), key=lambda kv: (kv[0][0], -kv[1]["cache_creation_tokens"])):
        print(
            f"{w:<12}{repo[:23]:<24}{model[:27]:<28}{r['stages']:>7}{fmt(r['prompt_tokens']):>9}"
            f"{fmt(r['cache_creation_tokens']):>9}{fmt(r['cached_input_tokens']):>9}{fmt(r['completion_tokens']):>9}"
        )


def report_background(calls):
    print("\n## Background\n")
    print(f"{'kind':<12}{'transcripts':>12}{'calls':>7}" + TOKEN_HEADER)
    for kind in ("summarizer", "warmup"):
        cs = [c for c in calls if c["t"]["kind"] == kind]
        print(f"{kind:<12}{len({id(c['t']) for c in cs}):>12}{len(cs):>7}" + token_cols(cs))


def report_repos(calls, week):
    buckets = defaultdict(list)
    for c in calls:
        buckets[c["t"]["repo"]].append(c)
    order = sorted(buckets.items(), key=lambda kv: -sum(ctx(c) for c in kv[1]))
    grand = sum(ctx(c) for c in calls) or 1
    print("\n## By repo\n")
    print(f"{'repo':<36}{'convs':>6}{'studio':>7}{'subagents':>10}{'background':>11}" + TOKEN_HEADER + f"{'share':>7}")
    for repo, b in order:
        n = counts(b)
        print(
            f"{repo[:35]:<36}{n['conversation']:>6}{n['studio']:>7}{n['subagent']:>10}{n['summarizer'] + n['warmup']:>11}"
            + token_cols(b) + f"{sum(ctx(c) for c in b) / grand * 100:>6.0f}%"
        )

    weeks = sorted({week(c) for c in calls})
    print("\n## Repo input by week (fresh + write + read)\n")
    print(f"{'repo':<36}" + "".join(f"{w:>12}" for w in weeks) + f"{'days used':>11}{'avg/day':>9}")
    for repo, b in order:
        per_week = defaultdict(int)
        for c in b:
            per_week[week(c)] += ctx(c)
        days = len({c["bucket"].date() for c in b})
        print(
            f"{repo[:35]:<36}" + "".join(f"{fmt(per_week[w]) if per_week[w] else '-':>12}" for w in weeks)
            + f"{days:>11}{fmt(sum(per_week.values()) / days):>9}"
        )


def write_csv(path, transcripts, week):
    fields = ["date", "week", "time", "kind", "title", "host", "cwd", "session_id", "calls", "start_ctx", "peak_ctx", *TOKENS]
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(fields)
        for t in sorted(transcripts, key=lambda t: t["start"]):
            w.writerow([
                f"{t['start']:%Y-%m-%d}", week(t["calls"][0]), f"{t['start']:%H:%M}", t["kind"], t["title"], t["host"], t["cwd"],
                t["session_id"], len(t["calls"]), t["start_ctx"], t["peak_ctx"], *(t[k] for k in TOKENS),
            ])


def write_json(path, calls):
    rows = {}
    for c in calls:
        t = c["t"]
        key = (t["host"], c["bucket"].isoformat(), t["cwd"], c["model"], t["kind"], t["automation"], t["work"])
        row = rows.setdefault(key, dict(
            zip(("host", "bucket", "cwd", "model", "kind", "automation", "work"), key),
            calls=0, long_context_calls=0, images=0, **dict.fromkeys(TOKENS, 0),
        ))
        row["calls"] += 1
        row["long_context_calls"] += ctx(c) > LONG_CONTEXT
        row["images"] += c["image_count"]
        for k in TOKENS:
            row[k] += c[k]
    with open(path, "w", encoding="utf-8") as f:
        json.dump(sorted(rows.values(), key=lambda r: r["bucket"]), f, indent=1)
    return len(rows)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--weeks", type=int, default=4)
    p.add_argument(
        "--reset", metavar="ISO_DATETIME", default="2026-01-04T18:00",
        help="weekly windows of 7 days ending at this Montreal time (default: Sundays 18:00)",
    )
    p.add_argument("--sessions", action="store_true", help="also list each conversation")
    p.add_argument("--csv", metavar="PATH", help="write one row per transcript to PATH")
    p.add_argument("--json", metavar="PATH", help="write token counts per host, 5-minute bucket, cwd, model and kind to PATH")
    p.add_argument("--studio-json", metavar="PATH", help="write Studio's own token counts per week, repo and model to PATH")
    args = p.parse_args()

    since = datetime.now(timezone.utc) - timedelta(weeks=args.weeks)
    reset = datetime.fromisoformat(args.reset).replace(tzinfo=TZ)
    week = week_key(reset)
    all_calls, transcripts, stats = load_all(since)
    # A local model reached through ANTHROPIC_BASE_URL is in the transcripts but not on the Claude limit.
    calls = [c for c in all_calls if c["model"].startswith("claude-")]
    left_out = defaultdict(int)
    for c in all_calls:
        if not c["model"].startswith("claude-"):
            left_out[c["model"] or "(none)"] += 1

    print(f"Claude Code sessions since {since.astimezone(TZ):%Y-%m-%d} (Montreal time)")
    print("background = conversation summaries and subagent warmups; start ctx = median first-call context of conversations")
    print(f"weeks end at {reset:%a %H:%M}, labelled by their end date")
    if left_out:
        print("left out, not Claude: " + ", ".join(f"{m} ({n} calls)" for m, n in sorted(left_out.items())))
    report("By day", calls, lambda c: f"{c['bucket']:%Y-%m-%d}")
    report("By week", calls, week)
    report_pace(calls, reset, since)
    report_models(calls, week)
    report_background(calls)
    report_repos(calls, week)
    report_images(calls, week)
    studio_records = load_studio_records(since, week)
    report_studio(calls, studio_records, week)

    if args.sessions:
        print("\n## Conversations\n")
        subs = defaultdict(int)
        for t in transcripts:
            if t["kind"] == "subagent":
                subs[t["session_id"]] += t["input"]
        for t in sorted((t for t in transcripts if t["kind"] == "conversation"), key=lambda t: t["start"]):
            print(
                f"{t['start']:%Y-%m-%d %H:%M}  {len(t['calls']):>4} calls  start {fmt(t['start_ctx']):>5}  peak {fmt(t['peak_ctx']):>5}"
                f"  input {fmt(t['input']):>6}  subagents {fmt(subs[t['session_id']]):>6}  {t['repo'][:24]:<24}  {t['title'] or '(untitled)'}"
            )

    if args.csv:
        write_csv(args.csv, transcripts, week)
        print(f"\nCSV: {len(transcripts)} rows written to {args.csv}")
    if args.json:
        print(f"\nJSON: {write_json(args.json, all_calls)} rows written to {args.json}")
    if args.studio_json:
        # Apart from --json: these calls can also be in the transcripts, so adding them up would count them twice.
        with open(args.studio_json, "w", encoding="utf-8") as f:
            json.dump([dict(zip(("week", "repo", "model"), k), **r) for k, r in sorted(studio_records.items())], f, indent=1)
        print(f"\nStudio JSON: {len(studio_records)} rows written to {args.studio_json}")

    print(f"\nDedupe: {stats['read']} records read, {stats['dropped']} duplicates dropped, "
          f"{stats['changed']} keys whose last record differs from the first")


if __name__ == "__main__":
    main()
